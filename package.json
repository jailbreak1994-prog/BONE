{
  "name": "ai-video-studio",
  "version": "1.0.0",
  "description": "Tạo video tự động bằng AI: kịch bản (LLM) → hình ảnh/video (AI) → giọng đọc (TTS) → ghép video (ffmpeg)",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "cli": "node --env-file-if-exists=.env src/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "ffmpeg-static": "^5.3.0",
    "gsap": "^3.15.0",
    "playwright-core": "^1.56.1"
  }
}
