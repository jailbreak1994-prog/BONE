# Sao chép thành .env rồi điền key của các dịch vụ bạn dùng (không cần điền tất cả).
# Provider nào thiếu key sẽ hiện ⚠️ trên giao diện. Provider "mock" luôn chạy được, không tốn phí.

# ---------- Máy chủ ----------
PORT=3000
HOST=127.0.0.1             # đặt 0.0.0.0 để truy cập từ máy khác / Docker
MAX_PARALLEL_JOBS=1        # số video xử lý cùng lúc
SCENE_CONCURRENCY=3        # số cảnh gọi API song song trong 1 video
# OUTPUT_DIR=output
# FFMPEG_PATH=/usr/bin/ffmpeg   # mặc định dùng ffmpeg-static cài kèm npm
# BACKGROUND_MUSIC=/đường/dẫn/nhac-nen.mp3
# BACKGROUND_MUSIC_VOLUME=0.15

# ---------- Viết kịch bản (LLM) ----------
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=medium        # low | medium | high | xhigh | max
OPENAI_API_KEY=                  # dùng chung cho GPT, gpt-image và OpenAI TTS
# OPENAI_MODEL=gpt-5
GEMINI_API_KEY=                  # dùng chung cho Gemini, Imagen và Veo
# GEMINI_MODEL=gemini-2.5-flash

# ---------- Tạo ảnh ----------
# OPENAI_IMAGE_MODEL=gpt-image-1
REPLICATE_API_TOKEN=
# REPLICATE_IMAGE_MODEL=black-forest-labs/flux-schnell
# GEMINI_IMAGE_MODEL=imagen-4.0-generate-001

# ---------- Tạo video clip ----------
RUNWAY_API_KEY=
# RUNWAY_MODEL=gen4_turbo
LUMA_API_KEY=
# LUMA_MODEL=ray-2
# VEO_MODEL=veo-3.0-fast-generate-001
# REPLICATE_VIDEO_MODEL=minimax/video-01
# REPLICATE_VIDEO_IMAGE_KEY=first_frame_image   # tên trường ảnh đầu vào của model Replicate
# REPLICATE_VIDEO_SEND_ASPECT=false

# ---------- Giọng đọc (TTS) ----------
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=alloy
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_MODEL=eleven_multilingual_v2
